ARG NODE_IMAGE=node:24.21.0-alpine3.24
FROM ${NODE_IMAGE}

# procps-ng: `nest start --watch` needs a full `ps` (not busybox) to kill the old app process on reload
RUN apk add --no-cache openssl ca-certificates procps-ng

WORKDIR /app
RUN chown node:node /app
USER node

COPY --chown=node:node package.json package-lock.json .npmrc ./
RUN npm ci

COPY --chown=node:node . .
# prisma/ is added in A-B3
RUN if [ -f prisma.config.ts ]; then npx prisma generate; fi

EXPOSE 3000 9229
CMD ["npm", "run", "start:dev"]
