enum BeneficiaryStatus {
  pending_confirmation
  confirmed
  revoked

  @@map("beneficiary_status")
  @@schema("withdrawals")
}

// Allow-listed withdrawal destination. Inactive until the owner confirms with 2FA
// and BENEFICIARY_ACTIVATION_DELAY_HOURS have elapsed since confirmation (A-B13.1).
model Beneficiary {
  id          String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerUserId String            @map("owner_user_id") @db.Uuid
  label       String            @db.VarChar(100)
  currency    String            @db.VarChar(10)
  address     String            @db.VarChar(256)
  network     String            @db.VarChar(64)
  status      BeneficiaryStatus @default(pending_confirmation)
  confirmedAt DateTime?         @map("confirmed_at") @db.Timestamptz(6)
  activeAt    DateTime?         @map("active_at") @db.Timestamptz(6)
  revokedAt   DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([ownerUserId, currency, network, address])
  @@index([ownerUserId, status, id])
  @@map("beneficiaries")
  @@schema("withdrawals")
}

// Transactional outbox for this context's audit/domain events (A-B9.3).
model WithdrawalsOutbox {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([processedAt, createdAt])
  @@map("outbox")
  @@schema("withdrawals")
}
