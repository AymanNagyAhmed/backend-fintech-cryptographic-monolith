// Per-subject encrypted PII vault (A-B11.2). Ciphertext from OpenBao Transit subject keys;
// after erasure the key is destroyed and rows become unreadable (2.8).
model SubjectPii {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectRef      String   @map("subject_ref") @db.Uuid
  field           String   @db.VarChar(64)
  ciphertext      String   @db.Text
  ciphertextHash  String   @map("ciphertext_hash") @db.Char(64)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([subjectRef, field])
  @@index([ciphertextHash])
  @@map("subject_pii")
  @@schema("privacy")
}

// Four-eyes erasure requests (A-B11.3). Completing requires a second distinct approver.
model ErasureRequest {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  subjectRef  String    @map("subject_ref") @db.Uuid
  requesterId String    @map("requester_id") @db.Uuid
  approverId  String?   @map("approver_id") @db.Uuid
  status      String    @db.VarChar(32)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@index([subjectRef, status])
  @@map("erasure_requests")
  @@schema("privacy")
}
