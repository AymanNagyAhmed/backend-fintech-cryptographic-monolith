enum AccountKind {
  wallet
  system

  @@map("account_kind")
  @@schema("ledger")
}

enum AccountStatus {
  active
  frozen
  closed

  @@map("account_status")
  @@schema("ledger")
}

// Double-entry account. balance is a cache of SUM(ledger_entries.amount), changed only by
// LedgerService.post in the transaction that inserts the entries (after SELECT ... FOR UPDATE).
// wallet accounts back one wallet.wallets row and can never go negative. system accounts
// (clearing, fees, ...) have a unique code; only they may set allowNegative, because the
// counter side of a deposit must go below zero when every posting sums to zero.
// currency, kind, code and allowNegative are fixed once created (trigger).
model Account {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  currency      String        @db.VarChar(10)
  kind          AccountKind
  code          String?       @unique @db.VarChar(64)
  allowNegative Boolean       @default(false) @map("allow_negative")
  balance       Decimal       @default(0) @db.Decimal(20, 8)
  status        AccountStatus @default(active)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  entries       LedgerEntry[]
  transfersFrom Transfer[]    @relation("TransferFrom")
  transfersTo   Transfer[]    @relation("TransferTo")

  @@map("accounts")
  @@schema("ledger")
}

// One row per posting (journal entry); the primary key makes a ref postable once, also under
// concurrency. Append-only like the entries.
model Posting {
  ref       String   @id @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entries  LedgerEntry[]
  transfer Transfer?

  @@map("postings")
  @@schema("ledger")
}

// Immutable debit (negative) / credit (positive) rows; corrections are new reversing entries.
// All entries with one ref form a posting: same currency, amounts sum to 0 (checked at commit).
// currency repeats the account's currency (trigger) so a posting is checkable without a join.
// seq orders an account's entries (statements, cursors); never order by created_at alone.
model LedgerEntry {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  seq       BigInt   @unique @default(autoincrement())
  accountId String   @map("account_id") @db.Uuid
  amount    Decimal  @db.Decimal(20, 8)
  currency  String   @db.VarChar(10)
  ref       String   @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id])
  posting Posting @relation(fields: [ref], references: [ref])

  @@index([accountId, seq])
  @@index([ref])
  @@map("ledger_entries")
  @@schema("ledger")
}

// One row per (scope, key): claimed with INSERT ... ON CONFLICT DO NOTHING in the same
// transaction as the money movement, so a retry can never run the work twice (2.10, 2.17).
// scope names the source and, for client keys, the caller (e.g. "transfer:<userId>"), so two
// users' keys or a client key and a provider event id never collide. requestHash is the SHA-256
// hex of the canonical request: same key + different request = reject. statusCode and response
// are written once, in the claiming transaction, and replayed on every retry (trigger).
// Purged after 30 days; the money movement itself stays in ledger_entries.
model IdempotencyKey {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  scope       String   @db.VarChar(100)
  key         String   @db.VarChar(255)
  requestHash String   @map("request_hash") @db.Char(64)
  statusCode  Int?     @map("status_code") @db.SmallInt
  response    Json?    @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_keys")
  @@schema("ledger")
}

// One wallet-to-wallet transfer, written in the transaction of its posting (ref). The posting
// moves exactly amount from fromAccountId to toAccountId (checked at commit). Wallet and user
// ids are plain UUIDs (wallet.wallets.id, auth.users.id), no FK across schemas. Append-only:
// a correction is a new transfer.
model Transfer {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ref             String   @unique @db.VarChar(128)
  fromAccountId   String   @map("from_account_id") @db.Uuid
  toAccountId     String   @map("to_account_id") @db.Uuid
  fromWalletId    String   @map("from_wallet_id") @db.Uuid
  toWalletId      String   @map("to_wallet_id") @db.Uuid
  amount          Decimal  @db.Decimal(20, 8)
  currency        String   @db.VarChar(10)
  initiatorUserId String   @map("initiator_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  posting     Posting @relation(fields: [ref], references: [ref])
  fromAccount Account @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("TransferTo", fields: [toAccountId], references: [id])

  // Daily limits (sum of today's outgoing amount per account) and per-user transfer lists
  @@index([fromAccountId, createdAt])
  @@index([toAccountId])
  @@index([initiatorUserId, id])
  @@map("transfers")
  @@schema("ledger")
}
