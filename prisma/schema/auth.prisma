enum UserRole {
  user
  approver
  compliance
  admin

  @@map("user_role")
  @@schema("auth")
}

enum UserStatus {
  active
  locked
  disabled

  @@map("user_status")
  @@schema("auth")
}

// email is stored lowercased (CHECK in the migration), so the unique index is case-insensitive.
// passwordHash is an argon2id PHC string ($argon2id$v=19$m=...,t=...,p=...$salt$hash).
model User {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  roles        UserRole[] @default([user])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  refreshTokens  RefreshToken[]
  totpCredential TotpCredential?

  @@map("users")
  @@schema("auth")
}

// Opaque refresh tokens; only HMAC-SHA256(JWT_REFRESH_SECRET, token) is stored.
// familyId groups the rotations of one login session: presenting an already used token
// revokes the whole family. Rows are never deleted (app_writer has no DELETE).
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  // The login that started the family passed TOTP; copied to every rotation
  mfa       Boolean   @default(false)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
  @@schema("auth")
}

// TOTP (RFC 6238, SHA-1, 6 digits, 30 s) second factor, one per user.
// secretEnc: AES-256-GCM with TOTP_ENCRYPTION_KEY, user id as AAD ("v1.<iv>.<tag>.<ciphertext>").
// enabledAt is null until the first code is confirmed. lastStep is the last accepted 30 s step,
// so a code is accepted once only.
model TotpCredential {
  userId    String    @id @map("user_id") @db.Uuid
  secretEnc String    @map("secret_enc")
  enabledAt DateTime? @map("enabled_at") @db.Timestamptz(6)
  lastStep  Int?      @map("last_step")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@map("totp_credentials")
  @@schema("auth")
}

enum ApiSigningAlgorithm {
  hmac_sha256
  ed25519

  @@map("api_signing_algorithm")
  @@schema("auth")
}

// B2B callers that sign requests (A-B4.5): method + path + timestamp + nonce + sha256(body).
// hmac_sha256: shared secret sealed with AES-256-GCM (API_CLIENT_ENCRYPTION_KEY, client_id as AAD).
// ed25519: only the raw 32-byte public key (base64url, the JWK "x"); the client keeps the private key.
// Identity and key are fixed once created (new key = new client); revoked_at can be set once.
model ApiClient {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  clientId  String              @unique @map("client_id") @db.VarChar(63)
  name      String              @db.VarChar(200)
  algorithm ApiSigningAlgorithm
  secretEnc String?             @map("secret_enc")
  publicKey String?             @map("public_key") @db.VarChar(43)
  revokedAt DateTime?           @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("api_clients")
  @@schema("auth")
}

// Transactional outbox for this context's audit/domain events (A-B9.3). Business code
// inserts in the same transaction as the state change; the chainer claims rows by setting
// processedAt (only allowed update). Extractable with the context later (0.7).
model AuthOutbox {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  payload     Json      @db.JsonB
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)

  // Unprocessed first, oldest first (chainer claim)
  @@index([processedAt, createdAt])
  @@map("outbox")
  @@schema("auth")
}
