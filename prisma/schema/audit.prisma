// Append-only hash-chained audit leaves (A-B9.4). HASH-partitioned by partition_key
// with 16 partitions (A-B12.2 / 2.15). PK includes partition_key (PostgreSQL rule).
model AuditEvent {
  id             String   @default(dbgenerated("uuidv7()")) @db.Uuid
  partitionKey   String   @map("partition_key") @db.VarChar(64)
  seq            BigInt   @db.BigInt
  payload        Json     @db.JsonB
  prevHash       String   @map("prev_hash") @db.Char(64)
  hash           String   @db.Char(64)
  sourceContext  String   @map("source_context") @db.VarChar(32)
  sourceId       String   @map("source_id") @db.Uuid
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([partitionKey, id])
  @@unique([partitionKey, seq])
  @@unique([partitionKey, sourceContext, sourceId])
  @@index([partitionKey, occurredAt])
  @@map("audit_events")
  @@schema("audit")
}

// Signed tree heads (STH) over the global Merkle tree of audit leaves (A-B10.2).
model TreeHead {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  treeSize        Int       @map("tree_size")
  rootHash        String    @map("root_hash") @db.Char(64)
  timestamp       DateTime  @db.Timestamptz(6)
  previousSthHash String?   @map("previous_sth_hash") @db.Char(64)
  alg             String    @db.VarChar(32)
  keyId           String    @map("key_id") @db.VarChar(128)
  signature       String    @db.Text
  tsaToken        Bytes?    @map("tsa_token")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([treeSize])
  @@index([createdAt])
  @@map("tree_heads")
  @@schema("audit")
}
