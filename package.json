{
  "name": "backend_monolith",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/ scripts/ && eslint src/ test/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "prisma:generate": "prisma generate --sql",
    "migrate:dev": "prisma migrate dev",
    "migrate:create": "prisma migrate dev --create-only",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "seed": "prisma db seed",
    "schema:ownership": "tsx scripts/check-schema-ownership.ts",
    "api-client": "tsx scripts/api-client.ts",
    "sign-request": "tsx scripts/sign-request.ts",
    "job:reconcile": "tsx scripts/reconcile.ts",
    "job:purge-idempotency-keys": "tsx scripts/purge-idempotency-keys.ts",
    "rotate:key": "tsx scripts/rotate-signing-key.ts",

    "postman:build": "tsx scripts/postman/build-collection.ts",
    "postman:check": "tsx scripts/postman/check-coverage.ts",
    "postman:env": "tsx scripts/postman/build-env.ts",
    "postman:test": "newman run postman/fintech-monolith.postman_collection.json -e postman/environments/dev.local.postman_environment.json --env-var freshUser=true --bail"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1152.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.12",
    "canonicalize": "5.1.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "joi": "18.2.9",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "10.12.0",
    "newman": "6.2.3",
    "openapi-to-postmanv2": "6.4.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pino-pretty": "13.2.0",
    "prettier": "^3.4.2",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.71.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": "24.21.0"
  }
}
