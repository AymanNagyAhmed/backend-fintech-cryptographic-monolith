# Backend app variables. Copy to .env and replace every change-me.
# The backend runs in WSL (make dev): PostgreSQL is the native one on 5432,
# Redis / OpenBao / S3 are Compose services published on 127.0.0.1.
NODE_ENV=development
PORT=3000

# Until A-B3 creates the roles app_writer and migrator, both URLs may use the postgres superuser
DATABASE_URL=postgresql://app_writer:change-me@localhost:5432/test_01
MIGRATOR_DATABASE_URL=postgresql://migrator:change-me@localhost:5432/test_01

# Password must match REDIS_PASSWORD in ../.env
REDIS_URL=redis://:change-me@localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

WEBHOOK_SECRET_STRIPE=change-me

# Token must match BAO_DEV_ROOT_TOKEN in ../.env (dev only)
BAO_ADDR=http://localhost:8200
BAO_TOKEN=change-me
SIGNING_KEY_NAME=audit-signing
SIGNING_ALG=ed25519

TSA_URL=https://freetsa.org/tsr

WORM_BUCKET=audit-worm
S3_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

CHECKPOINT_INTERVAL_SEC=60
