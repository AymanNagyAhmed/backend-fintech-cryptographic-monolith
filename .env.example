# Backend app variables. Copy to .env and replace every change-me.
# Hostnames are Compose service names.
NODE_ENV=development
PORT=3000

# Roles app_writer and migrator are created in A-B3 (docker/postgres/init/01-roles.sql)
DATABASE_URL=postgresql://app_writer:change-me@postgres:5432/fintech
MIGRATOR_DATABASE_URL=postgresql://migrator:change-me@postgres:5432/fintech

# Password must match REDIS_PASSWORD in ../.env
REDIS_URL=redis://:change-me@redis:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

WEBHOOK_SECRET_STRIPE=change-me

# Token must match BAO_DEV_ROOT_TOKEN in ../.env (dev only)
BAO_ADDR=http://openbao:8200
BAO_TOKEN=change-me
SIGNING_KEY_NAME=audit-signing
SIGNING_ALG=ed25519

TSA_URL=https://freetsa.org/tsr

WORM_BUCKET=audit-worm
S3_ENDPOINT=http://s3:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

CHECKPOINT_INTERVAL_SEC=60
