# Backend app variables. Copy to .env and replace every change-me.
# The backend runs in WSL (make dev); PostgreSQL / Redis / OpenBao / S3 are Compose
# services published on 127.0.0.1.
NODE_ENV=development
PORT=3000

# Runtime role and schema-owner role (passwords = APP_WRITER_PASSWORD / MIGRATOR_PASSWORD in ../.env)
DATABASE_URL=postgresql://app_writer:change-me@localhost:5433/fintech
MIGRATOR_DATABASE_URL=postgresql://migrator:change-me@localhost:5433/fintech

# Password must match REDIS_PASSWORD in ../.env
REDIS_URL=redis://:change-me@localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# AES-256-GCM key for TOTP secrets at rest: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=change-me
# AES-256-GCM key for B2B HMAC client secrets at rest: openssl rand -base64 32
API_CLIENT_ENCRYPTION_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Number of reverse proxies in front of the app (rate limits use the client IP); 0 in dev
TRUST_PROXY=0

WEBHOOK_SECRET_STRIPE=change-me
# Stripe secret key for GET /v1/events/:id before a deposit is credited.
# Leave unset to store signed payment.succeeded callbacks as rejected.
# STRIPE_SECRET_KEY=
# STRIPE_API_BASE=https://api.stripe.com

# OpenBao Transit (dev). After `make up` + A-B1.9 Transit init, run
# `npm run openbao:setup-audit-signer` (needs a root/admin token) and put the
# printed token in BAO_TOKEN. Keep the root token in BAO_ADMIN_TOKEN for rotate-key.
BAO_ADDR=http://localhost:8200
BAO_TOKEN=change-me
# Optional ops token (create/rotate Transit keys). Defaults to BAO_TOKEN when unset.
# BAO_ADMIN_TOKEN=
# openbao (dev), aws-kms (prod: KMS alias alias/<SIGNING_KEY_NAME>-v<n> per key version), local (tests only)
SIGNER_BACKEND=openbao
SIGNING_KEY_NAME=audit-signing
# Non-exportable custody key for withdrawal signing (A-B13.3); MPC documented in docs/custody-mpc.md
CUSTODY_SIGNING_KEY_NAME=custody-signing
# New signatures must use this alg (ed25519 | ecdsa-p256 | ml-dsa-65). Verify accepts any of them.
# OpenBao Transit has no ML-DSA; use aws-kms or SIGNER_BACKEND=local (tests) for ml-dsa-65.
SIGNING_ALG=ed25519

TSA_URL=https://freetsa.org/tsr

WORM_BUCKET=audit-worm
S3_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

CHECKPOINT_INTERVAL_SEC=60

# Trusted time (A-B16.5 / 2.9): chronyc on the host; stamp audit/STH when out of tolerance
CLOCK_OFFSET_TOLERANCE_SEC=0.1
# chronyc (default) or stub (offset 0 / ok; forced in NODE_ENV=test)
CLOCK_QUALITY_SOURCE=chronyc
CLOCK_CHRONYC_BIN=chronyc
CLOCK_QUALITY_CACHE_MS=5000

# OpenTelemetry (A-B16.7); set OTEL_SDK_DISABLED=true to skip. Jaeger OTLP via make obs-up.
OTEL_SDK_DISABLED=false
OTEL_SERVICE_NAME=fintech-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Wallets per user that are not closed (default 10)
WALLETS_MAX_PER_USER=10

# Outgoing transfers per source wallet and UTC calendar day, decimal strings at the
# currency scale (defaults below)
TRANSFER_DAILY_LIMIT_AED=50000.00
TRANSFER_DAILY_LIMIT_USD=15000.00
TRANSFER_DAILY_LIMIT_EUR=15000.00
TRANSFER_DAILY_LIMIT_BTC=1.00000000

# Hours after 2FA confirmation before a withdrawal allow-list entry is usable (default 24)
BENEFICIARY_ACTIVATION_DELAY_HOURS=24

# Withdrawal policy (A-B13.2): daily cap, four-eyes threshold, large-amount delay
WITHDRAWAL_DAILY_LIMIT_AED=20000.00
WITHDRAWAL_DAILY_LIMIT_USD=5000.00
WITHDRAWAL_DAILY_LIMIT_EUR=5000.00
WITHDRAWAL_DAILY_LIMIT_BTC=0.25000000
WITHDRAWAL_APPROVAL_THRESHOLD_AED=5000.00
WITHDRAWAL_APPROVAL_THRESHOLD_USD=1500.00
WITHDRAWAL_APPROVAL_THRESHOLD_EUR=1500.00
WITHDRAWAL_APPROVAL_THRESHOLD_BTC=0.05000000
WITHDRAWAL_LARGE_DELAY_THRESHOLD_AED=1000.00
WITHDRAWAL_LARGE_DELAY_THRESHOLD_USD=300.00
WITHDRAWAL_LARGE_DELAY_THRESHOLD_EUR=300.00
WITHDRAWAL_LARGE_DELAY_THRESHOLD_BTC=0.01000000
WITHDRAWAL_LARGE_DELAY_HOURS=24

# Max percent of client liabilities in the hot wallet before ops alert (A-B13.4, default 5)
HOT_WALLET_MAX_SHARE=5

# Nightly ledger reconciliation (BullMQ job scheduler), cron pattern in UTC (default 01:00)
RECONCILIATION_CRON=0 1 * * *

# Nightly purge of idempotency keys older than 30 days, cron pattern in UTC (default 01:30)
IDEMPOTENCY_PURGE_CRON=30 1 * * *

# Outbox -> audit_events chainer poll (BullMQ), UTC cron (default every 5 seconds)
CHAINER_CRON=*/5 * * * * *
# Max outbox rows to chain per job (default 50)
CHAINER_BATCH_SIZE=50
# Warn when unprocessed outbox rows reach this (default 1000); HTTP never waits on the chainer
OUTBOX_LAG_ALERT_THRESHOLD=1000
# Logical audit hash-chain partitions (k6 PARTITIONS=1|4|16). Restart after change.
AUDIT_PARTITION_COUNT=16

# Dev only, not read by the app: HMAC secret of the B2B dev-client, printed once by
# `npm run api-client -- create --id dev-client --name "Dev client" --alg hmac_sha256`.
# `npm run postman:env` copies it into Postman's b2bSecret.
B2B_DEV_SECRET=

# Dev only, not read by the app: password of the demo users created by `make seed`
# (alice@example.com, bob@example.com; at least 12 characters). Postman's userPassword
# logs in as alice when freshUser is false.
SEED_USER_PASSWORD=
